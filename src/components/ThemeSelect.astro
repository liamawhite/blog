---
import { Sun, Moon, Monitor } from 'lucide-react';
const modes = [
  { value: 'light', label: 'Light', Icon: Sun },
  { value: 'dark', label: 'Dark', Icon: Moon },
  { value: 'system', label: 'System', Icon: Monitor },
];
---

<fieldset id="theme" class="flex shrink-0 gap-1 rounded-xl border border-input bg-muted/50 p-1" disabled>
  <legend class="sr-only">Color theme</legend>
  {modes.map(({ value, label, Icon }) => (
    <label class="relative cursor-pointer" title={label}>
      <input class="peer sr-only" type="radio" name="theme" value={value} checked={value === 'system'} />
      <span class="flex size-8 items-center justify-center rounded-lg text-muted-foreground transition-colors hover:text-foreground peer-checked:bg-background peer-checked:text-foreground peer-checked:shadow-sm peer-focus-visible:ring-2 peer-focus-visible:ring-ring peer-disabled:opacity-50">
        <Icon size={16} aria-hidden="true" />
        <span class="sr-only">{label}</span>
      </span>
    </label>
  ))}
</fieldset>
